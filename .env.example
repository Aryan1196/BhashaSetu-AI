# BhashaSetu AI Environment Configuration

# Server Settings
PORT=8000
HOST=0.0.0.0
DEBUG=True
ENVIRONMENT=development

# Database Settings (SQLite local, PostgreSQL production)
DATABASE_URL=sqlite:///./bhashasetu.db
# DATABASE_URL=postgresql://user:password@localhost:5432/bhashasetu_db

# Vector Database Path
VECTOR_DB_PATH=./data/chroma_db

# AI Provider API Keys (Placeholder definitions - do not hardcode keys)
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
# LLM_MODEL=gpt-4o-mini
# LLM_API_BASE=https://api.groq.com/openai/v1
# LLM_API_BASE=https://api.openai.com/v1
DEMO_MODE=False

TRANSLATION_API_KEY=your_translation_api_key_here
SPEECH_API_KEY=your_speech_api_key_here
DEEPGRAM_API_KEY=

# Provider Choice Options ("mock", "openai", "indic", "whisper")
LLM_PROVIDER=openai
STT_PROVIDER=deepgram
TTS_PROVIDER=edge-tts
TRANSLATION_PROVIDER=deep_translator

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000


