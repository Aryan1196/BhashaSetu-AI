# BhashaSetu AI Environment Configuration

# Server Settings
PORT=8000
HOST=0.0.0.0
DEBUG=True
ENVIRONMENT=development

# Database Settings (SQLite local, PostgreSQL production)
DATABASE_URL=sqlite:///./bhashasetu.db
# DATABASE_URL=postgresql://user:password@localhost:5432/bhashasetu_db

# AI Provider Configuration (Modular abstractions)
# LLM Provider Options: "mock", "openai", "ollama", "groq"
LLM_PROVIDER=mock
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# Speech & Translation Providers
STT_PROVIDER=mock
TTS_PROVIDER=mock
TRANSLATION_PROVIDER=mock

# Vector Database (ChromaDB / FAISS)
CHROMA_PERSIST_DIR=./data/chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2

# CORS Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
